# ============================================================
# Migration Validator — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit real credentials.
# ============================================================


# ─────────────────────────────────────────────────────────────
# AI / DIAL Settings
# ─────────────────────────────────────────────────────────────
# Required for AI-powered rule assignment and SQL generation.
# Without DIAL_API_KEY the system uses static rule matching.
# IMPORTANT: EPAM DIAL API requires VPN connection.
#
# Find your key at: https://ai-proxy.lab.epam.com
# Check available models:
#   curl -s "https://ai-proxy.lab.epam.com/openai/models" \
#        -H "Api-Key: $DIAL_API_KEY"
# ─────────────────────────────────────────────────────────────
DIAL_API_KEY=your_dial_api_key_here
DIAL_API_BASE=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2025-04-01-preview

# AI Model Selection
# ─────────────────────────────────────────────────────────────
# Choose which model handles column rule assignment.
# Can be overridden per-run with --model flag or interactively.
#
# Available models:
#   gpt-4o            ← default (best accuracy)
#   gpt-4o-mini       ← faster, lower cost
#   gpt-4-turbo       ← high context window
#   claude-3-5-sonnet ← via DIAL bridge
#   gemini-pro        ← via DIAL bridge
# ─────────────────────────────────────────────────────────────
DIAL_MODEL=gpt-4o


# ─────────────────────────────────────────────────────────────
# Source Database — PostgreSQL
# ─────────────────────────────────────────────────────────────
SOURCE_HOST=localhost
SOURCE_PORT=5432
SOURCE_DATABASE=fms
SOURCE_SCHEMA=public
SOURCE_USERNAME=postgres
SOURCE_PASSWORD=your_postgres_password_here


# ─────────────────────────────────────────────────────────────
# Target Database — Snowflake
# Account format: ORGANIZATION_NAME-ACCOUNT_NAME
# (find in Admin → Account Details in Snowflake UI)
# ─────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_DATABASE=dev_edge_bronze
SNOWFLAKE_SCHEMA=storedge_fms_public
SNOWFLAKE_USERNAME=YOUR_USERNAME
SNOWFLAKE_PASSWORD=your_snowflake_password_here
