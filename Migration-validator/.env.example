# ════════════════════════════════════════════════════════════════════════════
# Migration Validator — Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit real credentials.
#
# FASTEST WAY TO SET UP:
#   cd src && python validate_cli.py setup
#   The wizard guides you through each field, tests connections, and
#   writes .env for you automatically.
# ════════════════════════════════════════════════════════════════════════════


# ── AI Settings — OPTION 1: EPAM DIAL (Recommended for EPAM employees) ──────
# Single API key gives access to GPT-4o, Claude, Gemini, Llama, Mistral.
# Requires EPAM VPN.  Get your key at: https://ai-proxy.lab.epam.com
# Configure interactively: python validate_cli.py  then choose [8]
# ─────────────────────────────────────────────────────────────────────────────
DIAL_API_KEY=your_dial_api_key_here
DIAL_API_BASE=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2025-04-01-preview

# Model to use for column rule assignment (DIAL models).
# Run  python validate_cli.py list-models  to see all working options.
# Best choices: gpt-4o | gpt-4o-mini | anthropic.claude-sonnet-5 | gemini-2.5-pro
DIAL_MODEL=gpt-4o


# ── AI Settings — OPTION 2: Anthropic Claude Direct ──────────────────────────
# Use this if you have a direct Anthropic API key (no EPAM VPN needed).
# CLAUDE_API_KEY is used ONLY when DIAL_API_KEY is not set.
# Get your key at: https://console.anthropic.com
# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE_API_KEY=sk-ant-api03-your-key-here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
#
# Available Claude models (direct API):
#   claude-3-5-sonnet-20241022   ← best quality (recommended)
#   claude-3-5-haiku-20241022    ← fastest, lowest cost
#   claude-3-opus-20240229       ← most powerful, slower
#   claude-3-haiku-20240307      ← fast, good for simple tables
#
# Priority: DIAL_API_KEY takes precedence over CLAUDE_API_KEY.
# If both are set, DIAL is used. Remove DIAL_API_KEY to use Claude directly.


# ── Snowflake Target ─────────────────────────────────────────────────────────
# All source databases are validated against this single Snowflake instance.
# Account format: ORGANISATION_NAME-ACCOUNT_NAME
# Find it: Snowflake UI → Admin → Accounts → copy 'Account Identifier'
# Do NOT include .snowflakecomputing.com
# ─────────────────────────────────────────────────────────────────────────────

SNOWFLAKE_ACCOUNT=ZJAUJWQ-EP12783
SNOWFLAKE_DATABASE=dev_edge_bronze
SNOWFLAKE_SCHEMA=storedge_fms_public
SNOWFLAKE_USERNAME=MANEGANESH99
SNOWFLAKE_PASSWORD=Ganeshmane@999

# Optional Snowflake settings (leave blank to use your user's defaults)
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=VALIDATOR_ROLE


# ── Source Connections — SRC_N_* format ─────────────────────────────────────
#
# IMPORTANT: SERVER ≠ DATABASE
# One PostgreSQL host can have many databases. Each (host + database + schema)
# combination is a SEPARATE connection with its own SRC_N_* slot.
#
# You can configure up to 10 source connections (any mix of db types).
# Each SRC_N_* block is fully independent — same host, different databases = 2 blocks.
#
# Supported types: postgresql | mssql | snowflake | athena
# Default ports:   postgresql=5432  |  mssql=1433  |  snowflake=443
#                  athena uses S3 (no port)
# ─────────────────────────────────────────────────────────────────────────────

# ── SRC_1: Primary source (PostgreSQL) ───────────────────────────────────────
SRC_1_TYPE=postgresql
SRC_1_HOST=localhost
SRC_1_PORT=5432
SRC_1_DATABASE=fms
SRC_1_SCHEMA=public
SRC_1_USERNAME=postgres
SRC_1_PASSWORD=12345

# ── SRC_2: Same server, different database ───────────────────────────────────
SRC_2_TYPE=mssqlserver
SRC_2_HOST=EPINHYDW1D68          # same server as SRC_1
SRC_2_PORT=1433
SRC_2_DATABASE=DevT5000        # DIFFERENT database on the same server
SRC_2_SCHEMA=dbo
SRC_2_USERNAME=AzureAD\GaneshRustumMane
SRC_2_PASSWORD=

# ── SRC_3: Different server entirely (MSSQL) ─────────────────────────────────
# SRC_3_TYPE=mssql
# SRC_3_HOST=mssql-crm.internal
# SRC_3_PORT=1433
# SRC_3_DATABASE=CRM
# SRC_3_SCHEMA=dbo
# SRC_3_USERNAME=crm_reader
# SRC_3_PASSWORD=your_password_here

# ── SRC_4: AWS Athena (S3 / Glue Data Catalog) ───────────────────────────────
# Athena has no traditional host/port. HOST is repurposed as the AWS region.
# The Glue database is used as both DATABASE and SCHEMA.
#
# Authentication options:
#   a) IAM role / instance profile  →  leave USERNAME and PASSWORD blank
#   b) Access key pair              →  set USERNAME=key_id, PASSWORD=secret_key
#
# SRC_4_TYPE=athena
# SRC_4_HOST=us-east-1             ← AWS region (repurposed host field)
# SRC_4_PORT=443                   ← placeholder — not used
# SRC_4_DATABASE=my_glue_database  ← Glue database name
# SRC_4_SCHEMA=my_glue_database    ← same as DATABASE for Athena
# SRC_4_USERNAME=                  ← AWS Access Key ID (blank = IAM role)
# SRC_4_PASSWORD=                  ← AWS Secret Access Key
#
# Athena-specific settings (shared across all Athena connections):
# ATHENA_REGION=us-east-1
# ATHENA_S3_OUTPUT=s3://your-bucket/athena-results/   ← REQUIRED for Athena
# ATHENA_CATALOG=AwsDataCatalog                       ← Glue catalog name
# ATHENA_WORKGROUP=primary                            ← Athena workgroup

# ── SRC_5: Another PostgreSQL database ───────────────────────────────────────
# SRC_5_TYPE=postgresql
# SRC_5_HOST=pg-analytics.internal
# SRC_5_PORT=5432
# SRC_5_DATABASE=analytics
# SRC_5_SCHEMA=reporting
# SRC_5_USERNAME=analytics_reader
# SRC_5_PASSWORD=your_password_here

# ── SRC_6 through SRC_10: Add as needed ─────────────────────────────────────
# (same pattern — uncomment and fill in)


# ── Legacy single-source keys (backward-compat — always point at SRC_1) ─────
# Used by: validate_cli.py generate  (single-table mode)
# The setup wizard writes these automatically from SRC_1_*.
# ─────────────────────────────────────────────────────────────────────────────
SOURCE_TYPE=postgresql
SOURCE_HOST=localhost
SOURCE_PORT=5432
SOURCE_DATABASE=fms
SOURCE_SCHEMA=public
SOURCE_USERNAME=postgres
SOURCE_PASSWORD=your_password_here


# ── MSSQL-specific (only needed for MSSQL sources) ───────────────────────────
# MSSQL_DRIVER=ODBC Driver 18 for SQL Server
