# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── DIAL / AI settings ──────────────────────────────────────────────────────
# Your personal EPAM DIAL API key (from https://ai-proxy.lab.epam.com).
# Key name: EPM-GPT-Ganesh_Rustummane_PERSONAL
# IMPORTANT: DIAL API requires EPAM VPN connection.
DIAL_API_KEY=<your_dial_api_key>
# --claude API KEY(Claude key test)
# DIAL Azure-compatible endpoint — do NOT add /openai suffix.
DIAL_API_BASE=https://ai-proxy.lab.epam.com

# Azure OpenAI API version expected by the DIAL proxy.
DIAL_API_VERSION=2025-04-01-preview

# Model deployment name. Use the exact deployment name from DIAL.
# Run: curl -s "https://ai-proxy.lab.epam.com/openai/models" -H "Api-Key: $DIAL_API_KEY"
# to see your available models and their current limits.
# Good options (check your personal key limits first):
#   gpt-4o                         — best reasoning quality for rule selection
#   gpt-5.6-terra-2026-07-09       — latest GPT-5 tier (if available on your key)
#   anthropic.claude-sonnet-5      — Claude Sonnet 5 (if available on your key)
DIAL_MODEL=gpt-4o

# ── Source database (optional — only needed for live connector mode) ─────────
# ── SRC_1: Primary source (PostgreSQL) ───────────────────────────────────────
SRC_1_TYPE=postgresql
SRC_1_HOST=localhost
SRC_1_PORT=5432
SRC_1_DATABASE=fms
SRC_1_SCHEMA=public
SRC_1_USERNAME=postgres
SRC_1_PASSWORD=<password>

# ── SRC_2: MS SQL Server (Windows/NTLM authentication) ──────────────────────
SRC_2_TYPE=mssqlserver
SRC_2_HOST=<USERID>
SRC_2_PORT=1433
SRC_2_DATABASE=DevT5000
SRC_2_SCHEMA=dbo
SRC_2_AUTH=windows
SRC_2_USERNAME=AzurAD\<username>
SRC_2_PASSWORD=


# ── SRC_3: Different server entirely (MSSQL) ─────────────────────────────────
# ── SRC_3: Athena Source ───────────────────────────────────
SRC_3_TYPE=athena
SRC_3_REGION=eu-north-1
SRC_3_DATABASE=migration_validator_test
SRC_3_SCHEMA=
SRC_3_TABLE=addresses
SRC_3_S3_LOCATION=s3://athena-addresses/Addresses/
SRC_3_QUERY_RESULT_LOCATION=s3://athena-addresses/athena-query-results/
SRC_3_USERNAME=<username>
SRC_3_PASSWORD=<password>

# ── SRC_4: AWS Athena (S3 / Glue Data Catalog) ───────────────────────────────
# Athena has no traditional host/port. HOST is repurposed as the AWS region.
# The Glue database is used as both DATABASE and SCHEMA.
#
# Authentication options:
#   a) IAM role / instance profile  →  leave USERNAME and PASSWORD blank
#   b) Access key pair              →  set USERNAME=key_id, PASSWORD=secret_key
#
# SRC_4_TYPE=athena
# SRC_4_HOST=us-east-1             ← AWS region (repurposed host field)
# SRC_4_PORT=443                   ← placeholder — not used
# SRC_4_DATABASE=my_glue_database  ← Glue database name
# SRC_4_SCHEMA=my_glue_database    ← same as DATABASE for Athena
# SRC_4_USERNAME=                  ← AWS Access Key ID (blank = IAM role)
# SRC_4_PASSWORD=                  ← AWS Secret Access Key
#
# Athena-specific settings (shared across all Athena connections):
# ATHENA_REGION=us-east-1
# ATHENA_S3_OUTPUT=s3://your-bucket/athena-results/   ← REQUIRED for Athena
# ATHENA_CATALOG=AwsDataCatalog                       ← Glue catalog name
# ATHENA_WORKGROUP=primary                            ← Athena workgroup

# ── SRC_5: Another PostgreSQL database ───────────────────────────────────────
# SRC_5_TYPE=postgresql
# SRC_5_HOST=pg-analytics.internal
# SRC_5_PORT=5432
# SRC_5_DATABASE=analytics
# SRC_5_SCHEMA=reporting
# SRC_5_USERNAME=analytics_reader
# SRC_5_PASSWORD=your_password_here


# ── Snowflake target ─────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=ZJAUJWQ-XXXX
SNOWFLAKE_DATABASE=dev_edge_bronze
SNOWFLAKE_SCHEMA=storedge_fms_public
SNOWFLAKE_USERNAME=<username>
SNOWFLAKE_PASSWORD=<password>
